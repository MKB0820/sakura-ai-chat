{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sakura-ai-chat",
  "main": "worker/entry.ts",
  "compatibility_date": "2026-11-20",
  // Auth.js, Prisma and node:crypto need the Node.js compatibility layer.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Argon2 runs in this Durable Object: Workers Free caps normal invocations
  // at 10ms CPU, while Durable Objects get 30s.
  "durable_objects": {
    "bindings": [{ "name": "AUTH_HASHER", "class_name": "AuthHasher" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuthHasher"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sakura-ai-chat-db",
      "database_id": "4e18e014-ca20-4888-b599-da647238fea4",
      "migrations_dir": "d1-migrations"
    }
  ],
  // Non-secret runtime configuration (model window for the usage meter).
  "vars": {
    "DEEPSEEK_CONTEXT_TOKENS": "1048576"
  },
  "observability": {
    "enabled": true
  }
}
